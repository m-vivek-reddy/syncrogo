{
  "expo": {
    "name": "SyncroGo",
    "slug": "syncro-go",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/syncrogo-app-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/syncrogo-app-icon.png"
    },
    "android": {
      "icon": "./assets/images/syncrogo-app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/syncrogo-app-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.syncrogo.app",
      "versionCode": 3,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/syncrogo-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 115
        }
      ],
      "expo-secure-store",
      [
        "@maplibre/maplibre-react-native",
        {
          "androidLocationService": "fused"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SyncroGo to use your location to find and offer rides."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74a09f99-ce27-4fdc-9f33-392c215d63ee"
      }
    },
    "owner": "vivekreddy22s-team"
  }
}
