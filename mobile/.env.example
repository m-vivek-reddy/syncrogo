# ==============================================================================
# SyncroGo Mobile (Expo) Environment Configuration Template
# Copy this file to .env or .env.local and configure your environment values.
# Expo variables accessible in JS must be prefixed with EXPO_PUBLIC_
# ==============================================================================

# Backend API Endpoint (Optional: automatically resolved from Expo hostUri if omitted)
# EXPO_PUBLIC_API_URL=http://localhost:8000
# EXPO_PUBLIC_API_URL=https://syncrogo-backend.onrender.com
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# EXPO_PUBLIC_API_URL=https://your-tunnel-8000.inc1.devtunnels.ms

# Backend WebSocket Endpoint
# EXPO_PUBLIC_WS_URL=ws://localhost:8000
