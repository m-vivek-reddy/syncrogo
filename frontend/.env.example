# ==============================================================================
# SyncroGo Frontend Environment Configuration Template
# Copy this file to .env or .env.local and configure your environment values.
# All Vite variables must be prefixed with VITE_
# ==============================================================================

# Backend API Endpoint
VITE_API_URL=https://syncrogo-backend.onrender.com
VITE_API_BASE_URL=https://syncrogo-backend.onrender.com

# Backend WebSocket Endpoint
VITE_WS_URL=ws://localhost:8000

# Payment Gateway (Razorpay Public Key ID)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
