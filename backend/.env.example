# ==============================================================================
# SyncroGo Backend Environment Configuration Template
# Copy this file to .env and configure your environment-specific values.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Database Configuration
# PostgreSQL (Production / Development):
# DATABASE_URL=postgresql://user:password@localhost:5432/syncrogo_db
# SQLite (Local Development / Testing):
DATABASE_URL=sqlite:///./syncrogo.db

# JWT & Security Configuration
# Generate a strong 32+ character random string (e.g., openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Server & Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
# Frontend base URL used in password-reset email links.
# Use the public dev tunnel when testing from another device:
# FRONTEND_URL=https://hj4cqztk-5173.inc1.devtunnels.ms
FRONTEND_URL=http://localhost:5173

# Resend (preferred — HTTP API, no outbound SMTP port required).
# If RESEND_API_KEY is set it takes precedence over the SMTP settings below.
# RESEND_FROM must be a sender on a domain verified in Resend.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=SyncroGo <onboarding@resend.dev>

# Gmail SMTP fallback (for OTP verification and password reset)
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=your-gmail@gmail.com

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
